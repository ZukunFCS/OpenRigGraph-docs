{
  "version": 1,
  "format": "OpenRigGraph",
  "controllers": [
    {"name": "smile", "min": 0, "max": 1, "default": 0, "clamp": false},
    {"name": "twist", "min": -30, "max": 30, "default": 0, "clamp": false}
  ],
  "outputs": [
    {"name": "smileWeight", "type": "scalar", "source": "smileClamp.outputR"},
    {"name": "twistValue", "type": "scalar", "source": "twistPass.output"}
  ],
  "nodes": [
    {"name": "smileClamp", "type": "clamp", "min": [0,0,0], "max": [1,1,1], "inputs": {"inputR": "smile"}},
    {"name": "twistPass", "type": "ScalarMathNode", "op": "identity", "inputs": {"input": "twist"}}
  ]
}
